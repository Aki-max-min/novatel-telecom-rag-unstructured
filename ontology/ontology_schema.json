        "Tag",
        "VerificationMethod"
      ],
      "source": "data/processed/documents/*.json"
    },
    "structured": {
      "description": "The 28 SQL tables as an instance graph: one node per row, one edge per foreign key.",
      "node_labels": [
        "CDR",
        "CorporateAccount",
        "Coverage5G",
        "Customer",
        "DeviceConfig",
        "DeviceRegistry",
        "ESIMProfile",
