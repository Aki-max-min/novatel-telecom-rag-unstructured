{
  "schema_name": "NovaTel Unstructured Knowledge Graph Ontology",
  "schema_version": "4.0.0",
  "phase": "Phase 5 - document KG + structured KG + the shared Concept layer that bridges them",
  "owner": "Person B (Ontology & Knowledge Graph layer)",
  "source_corpus": {
    "path": "data/processed/documents/*.json",
    "document_count": 148,
    "produced_by": "Person A unstructured ingestion pipeline",
    "access": "read-only"
  },
  "extraction_policy": {
    "deterministic_only": true,
    "nlp_used": false,
    "llm_used": false,
    "ml_used": false,
    "rule": "Metadata nodes and edges are read verbatim from declared fields. Content concepts come from a curated dictionary of canonical concept names mapped to explicit case-insensitive trigger phrases, matched on non-alphanumeric boundaries. No inference, no text mining, no embeddings, no LLM, no spaCy. Re-running the extractors on the same corpus reproduces identical output.",
    "content_method": "curated_pattern_dictionary"
  },
  "node_id_convention": "<NodeLabel>::<key_value>",
  "node_labels": [
    {
      "label": "Document",
      "source_field": "document_id",
      "key": "document_id",
      "description": "A canonical unstructured document produced by the ingestion pipeline, or an unresolved stub referenced by related_ids.",
      "properties": [
        "title",
        "document_type",
        "version",
        "last_updated",
        "file_type",
        "source_authority",
        "resolved"
      ]
    },
    {
      "label": "DocumentType",
      "source_field": "document_type",
      "key": "document_type",
      "description": "The editorial form of a document (FAQ, SOP, RCA, Policy, ...).",
      "properties": [
        "name"
      ]
    },
    {
      "label": "Category",
      "source_field": "category",
      "key": "category",
      "description": "A NovaTel business category code carried in document metadata.",
      "properties": [
        "name",
        "name_source"
      ]
    },
    {
      "label": "Department",
      "source_field": "department",
      "key": "department",
      "description": "The internal business unit that owns the document.",
      "properties": [
        "name"
      ]
    },
    {
      "label": "CustomerScope",
      "source_field": "customer_scope",
      "key": "customer_scope",
      "description": "The customer segment a document applies to (all, prepaid, postpaid, enterprise).",
      "properties": [
        "name"
      ]
    },
    {
      "label": "Tag",
      "source_field": "tags",
      "key": "tag",
      "description": "A free-form keyword attached to a document by the ingestion pipeline.",
      "properties": [
        "name"
      ]
    },
    {
      "label": "SourceAuthority",
      "source_field": "source_authority",
      "key": "source_authority",
      "description": "The authority that published or vouches for the document.",
      "properties": [
        "name"
      ]
    },
    {
      "label": "Dataset",
      "source_field": "document_id",
      "key": "dataset",
      "description": "Corpus of origin. Derived deterministically: 'SciFact' when document_id starts with 'SCIFACT_', otherwise 'NovaTel'.",
      "properties": [
        "name"
      ]
    },
    {
      "label": "Service",
      "source_field": "content,title",
      "key": "canonical service name",
      "description": "A customer-facing telecom service or transaction named in the document text.",
      "properties": [
        "name",
        "concept_type",
        "extraction_method",
        "trigger_count",
        "document_frequency"
      ]
    },
    {
      "label": "Channel",
      "source_field": "content,title",
      "key": "canonical channel name",
      "description": "A channel through which a service is delivered (app, portal, IVR, helpline, website).",
      "properties": [
        "name",
        "concept_type",
        "extraction_method",
        "trigger_count",
        "document_frequency"
      ]
    },
    {
      "label": "VerificationMethod",
      "source_field": "content,title",
      "key": "canonical method name",
      "description": "A mechanism used to verify a customer's identity (OTP, Video KYC, biometric).",
      "properties": [
        "name",
        "concept_type",
        "extraction_method",
        "trigger_count",
        "document_frequency"
      ]
    },
    {
      "label": "Requirement",
      "source_field": "content,title",
      "key": "canonical requirement name",
      "description": "A document or artefact the customer must produce (valid photo ID, address proof, passport).",
      "properties": [
        "name",
        "concept_type",
        "extraction_method",
        "trigger_count",
        "document_frequency"
      ]
    },
    {
      "label": "Location",
      "source_field": "content,title",
      "key": "canonical location name",
      "description": "A physical place a customer is directed to (Experience Store, retail outlet).",
      "properties": [
        "name",
        "concept_type",
        "extraction_method",
        "trigger_count",
        "document_frequency"
      ]
    }
  ],
  "relationship_types": [
    {
      "type": "BELONGS_TO_CATEGORY",
      "from": "Document",
      "to": "Category",
      "source_field": "category",
      "cardinality": "1 per document"
    },
    {
      "type": "IS_TYPE",
      "from": "Document",
      "to": "DocumentType",
      "source_field": "document_type",
      "cardinality": "1 per document"
    },
    {
      "type": "OWNED_BY_DEPARTMENT",
      "from": "Document",
      "to": "Department",
      "source_field": "department",
      "cardinality": "1 per document"
    },
    {
      "type": "APPLIES_TO_SCOPE",
      "from": "Document",
      "to": "CustomerScope",
      "source_field": "customer_scope",
      "cardinality": "1 per document"
    },
    {
      "type": "HAS_TAG",
      "from": "Document",
      "to": "Tag",
      "source_field": "tags",
      "cardinality": "0..n per document, one edge per tag"
    },
    {
      "type": "AUTHORED_BY",
      "from": "Document",
      "to": "SourceAuthority",
      "source_field": "source_authority",
      "cardinality": "1 per document"
    },
    {
      "type": "PART_OF_DATASET",
      "from": "Document",
      "to": "Dataset",
      "source_field": "document_id",
      "cardinality": "1 per document"
    },
    {
      "type": "RELATED_TO",
      "from": "Document",
      "to": "Document",
      "source_field": "related_ids",
      "cardinality": "0..n per document, target may be an unresolved stub"
    },
    {
      "type": "MENTIONS_SERVICE",
      "from": "Document",
      "to": "Service",
      "source_field": "content,title",
      "cardinality": "0..n per document, one edge per distinct service"
    },
    {
      "type": "MENTIONS_CHANNEL",
      "from": "Document",
      "to": "Channel",
      "source_field": "content,title",
      "cardinality": "0..n per document, one edge per distinct channel"
    },
    {
      "type": "MENTIONS_VERIFICATION",
      "from": "Document",
      "to": "VerificationMethod",
      "source_field": "content,title",
      "cardinality": "0..n per document, one edge per distinct method"
    },
    {
      "type": "MENTIONS_REQUIREMENT",
      "from": "Document",
      "to": "Requirement",
      "source_field": "content,title",
      "cardinality": "0..n per document, one edge per distinct requirement"
    },
    {
      "type": "MENTIONS_LOCATION",
      "from": "Document",
      "to": "Location",
      "source_field": "content,title",
      "cardinality": "0..n per document, one edge per distinct location"
    },
    {
      "type": "AVAILABLE_VIA",
      "from": "Service",
      "to": "Channel",
      "source_field": "content_cooccurrence",
      "cardinality": "0..n, aggregated across documents",
      "confidence": "cooccurrence"
    },
    {
      "type": "REQUIRES_VERIFICATION",
      "from": "Service",
      "to": "VerificationMethod",
      "source_field": "content_cooccurrence",
      "cardinality": "0..n, aggregated across documents",
      "confidence": "cooccurrence"
    },
    {
      "type": "REQUIRES_DOCUMENT",
      "from": "Service",
      "to": "Requirement",
      "source_field": "content_cooccurrence",
      "cardinality": "0..n, aggregated across documents",
      "confidence": "cooccurrence"
    }
  ],
  "dangling_reference_policy": {
    "field": "related_ids",
    "rule": "A related_id that does not match any of the 148 canonical document_ids is NOT dropped. A stub Document node is created with resolved=false and the RELATED_TO edge is still written.",
    "stub_node_properties": {
      "resolved": false,
      "stub": true
    },
    "metric": "unresolved_rate = related_ids_unresolved / related_ids_total"
  },
