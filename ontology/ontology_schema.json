      "Recharge",
      "Retail & Store Network",
      "Roaming",
      "SIM Card Services",
      "Security & Fraud",
      "Subscription",
      "Usage Records",
      "Value Added Services"
    ],
    "node_id_convention": "Concept::<concept name>",
    "concepts_bridging_both_sides": 22,
    "concepts_structured_side_only": [
      "Retail & Store Network"
    ],
    "unmapped_document_services": [
      "DND Activation",
      "Loyalty Redemption",
      "Refund"
    ],
    "unmapped_structured_entity_types": [],
    "unmapped_rationale": {
      "DND Activation": "No DND table exists on the structured side, so no concept realizes it. Mapping it would create a bridge that bridges nothing.",
      "Refund": "Refunds live inside payment_transactions, which realizes Payments. There is no separate Refund concept to map to.",
      "Loyalty Redemption": "Not in the seeded mapping and no Loyalty concept exists. Offers & Promotions is a different concept (the offers table), so mapping to it would be a guess."
    },
    "service_concept_mapping": {
      "Bill Payment": "Payments",
      "Broadband/FTTH Installation": "Broadband & FTTH Services",
      "Complaint Registration": "Complaints & Grievances",
      "KYC Verification": "KYC & Identity Verification",
      "Mobile Number Update": "Customer Account",
      "Number Portability": "Number Portability",
      "Plan Change": "Plan Catalogue",
      "Recharge": "Recharge",
      "Roaming Activation": "Roaming",
      "SIM Swap": "SIM Card Services",
      "VAS Subscription": "Value Added Services",
      "eSIM Activation": "SIM Card Services"
    },
    "service_concept_mapping_notes": {
      "Plan Change": "Mapped to Plan Catalogue rather than Subscription: changing plan is an act against the catalogue, while the Subscription concept is realized by the subscriptions table.",
      "VAS Subscription": "Kept because the concept exists, but the document branch has no Service with this name, so it produces no edge."
    }
  },
