        "RetailOutlet",
        "RoamingUsage",
        "SIMInventory",
        "Subscription",
        "Technician",
        "Ticket",
        "VASSubscription"
      ],
      "source": "data/processed/structured/novatel_structured.db",
      "schema_of_record": "structured/schema.py TABLE_SCHEMAS (imported, never hardcoded)",
      "instance_nodes": 43928,
      "fk_edges": 31027,
      "fk_integrity_rate": 1.0,
      "entity_types": 28,
      "distinct_categories": 24,
      "node_id_convention": "<EntityType>:<primary_key>  (single colon)",
      "id_collision_note": "The document branch uses '<Label>::<key>' (double colon) and the structured branch '<EntityType>:<pk>' (single colon), so ids from the two graphs can never collide even in one database.",
      "views": {
        "instance": "43,928 row nodes + 31,027 FK edges (structured_kg.graphml)",
        "schema": "28 EntityType nodes + 24 StructuredCategory nodes + 20 FK relationship edges + 28 IN_CATEGORY edges (structured_schema_kg.graphml)"
      }
    }
  },
