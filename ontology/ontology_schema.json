  "layers": {
    "metadata": {
      "description": "Phase 1. Nodes and edges read verbatim from document metadata fields.",
      "node_labels": [
        "Category",
        "CustomerScope",
        "Dataset",
        "Department",
        "Document",
        "DocumentType",
        "SourceAuthority",
        "Tag"
      ],
      "relationship_types": [
        "APPLIES_TO_SCOPE",
        "AUTHORED_BY",
        "BELONGS_TO_CATEGORY",
        "HAS_TAG",
        "IS_TYPE",
        "OWNED_BY_DEPARTMENT",
        "PART_OF_DATASET",
        "RELATED_TO"
      ]
    },
    "content": {
      "description": "Phase 2. Telecom concepts extracted from document title and content with a curated pattern dictionary.",
      "node_labels": [
        "Service",
        "Channel",
        "VerificationMethod",
        "Requirement",
        "Location"
      ],
      "relationship_types": [
        "MENTIONS_SERVICE",
        "MENTIONS_CHANNEL",
        "MENTIONS_VERIFICATION",
        "MENTIONS_REQUIREMENT",
        "MENTIONS_LOCATION",
        "AVAILABLE_VIA",
        "REQUIRES_VERIFICATION",
        "REQUIRES_DOCUMENT"
      ]
    }
  },
  "content_layer_policy": {
    "dictionary_location": "knowledge_graph/content_extractor.py (CONCEPT_DICTIONARY)",
    "scanned_fields": [
      "title",
      "content"
    ],
    "matching": "Case-insensitive literal phrase bounded by (?<![A-Za-z0-9]) and (?![A-Za-z0-9]), so 'port' cannot fire inside 'portal' and 'pan' cannot fire inside 'Pan-India'.",
    "evidence": "Every MENTIONS_* edge carries matched_terms, match_count, evidence_span and an evidence snippet, so any edge is traceable to the exact words that produced it.",
    "verification_vs_requirement": "A phrase naming a verification act (OTP, Video KYC, biometric) is a VerificationMethod. A phrase naming a document the customer must produce (valid photo ID, address proof, passport) is a Requirement.",
    "cooccurrence_edges": {
      "types": [
        "AVAILABLE_VIA",
        "REQUIRES_VERIFICATION",
        "REQUIRES_DOCUMENT"
      ],
      "rule": "Both concepts mentioned in the same document.",
      "confidence": "cooccurrence",
      "caveat": "Heuristic association, not an asserted fact. Each edge carries support (number of backing documents) and evidence_document_ids."
    },
    "concepts_declared_but_unevidenced": "A concept with no match in the corpus stays in the dictionary and is reported by the extractor, but does not become an orphan node.",
    "ground_truth_document": {
      "document_id": "FAQ_C01_001",
      "expected": {
        "Service": [
          "Mobile Number Update"
        ],
        "Channel": [
          "My NovaTel App",
          "Self-Care Portal"
        ],
        "VerificationMethod": [
          "OTP"
        ],
        "Location": [
          "NovaTel Experience Store"
        ],
        "Requirement": [
          "Valid Photo ID"
        ]
      }
    }
  },
  "branches": {
    "document": {
      "description": "The 148 unstructured documents. Phases 1-3. Unchanged.",
      "node_labels": [
        "Category",
        "Channel",
        "CustomerScope",
        "Dataset",
        "Department",
